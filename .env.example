# ローカル検証: このファイルを .env.local にコピーしてください。
# 本番では KENSHO_MODE=supabase に変更し、下記の接続情報を設定します。
KENSHO_MODE=demo
APP_ORIGIN=http://127.0.0.1:3000
KENSHO_DB_PATH=.data/kensho.sqlite
TEST_FORM_ORIGIN=http://127.0.0.1:3000

# Supabase の Project Settings > API から取得。
# URL と anon key のみ公開可能。service_role と暗号鍵はサーバー専用です。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 本番必須: openssl rand -base64 32 で生成し、安全な場所で保管。
# ローカルで空の場合は .data/profile.key が自動生成されます。
# 既存データがある状態で暗号鍵を変更・削除しないでください。
PROFILE_ENCRYPTION_KEY=

# システム Chromium を使用する場合だけパスを指定。
# 空なら npx playwright install chromium で取得したブラウザを使用。
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# 初期版は実サイト用送信アダプター未登録です。
# true に変更するだけでは実サイト送信は有効になりません。
ENABLE_LIVE_SUBMISSIONS=false

# HTTPS_PROXY が設定された環境でのみ必要になる安全確認。
# 信頼するプロキシが DNS 解決後の private/reserved 宛先を常に拒否することを
# 運用者が確認できた場合だけ 1 にします。未確認では収集を停止します。
# 通常の GitHub Actions (プロキシなし) とローカル fixture には不要です。
# KENSHO_PROXY_PUBLIC_DESTINATIONS_ONLY=1
